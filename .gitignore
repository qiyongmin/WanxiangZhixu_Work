# KB_Work minimum Work-only source distribution.
# Everything not explicitly allowed is local-only (including live company data).
# Git-tracked paths must be untracked using "git rm --cached" on a reviewed list.
# This allowlist does not grant publication or company information-sharing approval.

/*
!/.gitignore
# GitHub Actions is the only published CI configuration; the old GitLab
# pipeline stays local in this working checkout and outside the public snapshot.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/WORKSPACE_KIND
!/README.md
!/DEPLOYMENT_WINDOWS_WSL_ZH.md
!/ARCHITECTURE.md
!/OPERATIONS.md
!/SECURITY.md
!/PUBLIC_RELEASE.md
!/THIRD_PARTY_NOTICES.md
!/UI_DESIGN_SYSTEM.md
!/LICENSE
!/CONTRIBUTING.md
!/DEVELOPMENT.md
!/DATA_MODEL.md
!/AGENTS.template.md
!/requirements.txt
!/index.html
!/start.sh
!/stop.sh
!/start.bat
!/stop.bat

# The active React/Vite application, all production modules and UI assets.
# Test files are gated individually; everything else under web/ is source.
!/web/
/web/*
!/web/index.html
!/web/package.json
!/web/package-lock.json
!/web/tsconfig.json
!/web/tsconfig.node.json
!/web/vite.config.ts
!/web/vitest.config.ts
!/web/src/
# Legacy vendor-named stylesheet is kept locally for safe rollback only.
/web/src/styles/eds.css
!/web/public/
!/web/scripts/
!/web/tests/
/web/tests/*
!/web/tests/setup.ts
!/web/tests/helpers.tsx
!/web/tests/fixtures.ts
!/web/tests/p2.ts
!/web/tests/shell.test.tsx
!/web/tests/design-system.test.tsx
!/web/tests/agent.test.tsx
!/web/tests/materials.test.tsx
!/web/tests/notebook-v3.test.tsx
!/web/tests/notebook-v34.test.tsx
!/web/tests/tasks.test.tsx
!/web/tests/kanban.test.tsx
!/web/tests/router.test.ts
!/web/tests/visual-styles.test.tsx
!/web/tests/ui-layout.test.tsx
!/web/tests/resources.test.tsx
!/web/tests/prompt-notebook.test.tsx
!/web/tests/agent-journal.test.tsx
!/web/tests/resources-workspaces.test.tsx
!/web/tests/notebook-v35.test.tsx
!/web/tests/notebook-table-tools.test.tsx

# All Skills (including generic Work Skills) are local-only. Public GitHub ships only the manager, never Skill content.
